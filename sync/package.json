{
  "name": "couch-tour-sync",
  "private": true,
  "version": "0.1.0",
  "description": "Progress-sync backend for Couch Tour (Cloudflare Workers + D1). See DECISIONS.md.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:local": "wrangler d1 execute couch-tour-sync --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute couch-tour-sync --remote --file=schema.sql",
    "db:migrate:staging": "wrangler d1 execute couch-tour-sync-staging --remote --file=schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.4"
  }
}
