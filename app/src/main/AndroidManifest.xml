<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR pairing's scan side only — declared optional since a device with no camera can
         still pair by typing the code. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
        Google TV / Android TV foundation (#182). required="false" on both: this is one
        APK shared with phones/tablets (there's no separate TV module or flavor), so it must
        keep installing there — a leanback-required manifest would make Play (and sideloading)
        refuse the app on any device that doesn't report a TV UI mode. TvMainActivity below is
        the actual leanback-launcher entry point; declaring the feature here is what tells a
        TV's Play Store listing and launcher this app has a TV-shaped surface at all.
    -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".CouchTourApp"
        android:allowBackup="false"
        android:icon="@mipmap/${appIcon}"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.CouchTour">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CouchTour">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The Google TV / Android TV entry point (#182), separate from MainActivity: a
            leanback-launched Activity gets opened directly from a TV home screen row, never
            through the phone's LAUNCHER category, so it needs its own intent-filter rather
            than a shared one. android:banner is required for a leanback launcher entry to
            render as more than a bare icon in that row.
        -->
        <activity
            android:name=".TvMainActivity"
            android:banner="@mipmap/${appIcon}"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CouchTour">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The Cast framework instantiates this itself, on first use of CastContext, to
            learn which receiver app to talk to.
        -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="dev.mike.couchtour.CastOptionsProvider" />

        <!--
            Tells Android Auto this is a media app and where to find its browse tree
            description. Automotive OS (no phone, full in-car OS) is a separate, larger
            effort and deliberately not declared here.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>

    </application>
</manifest>
