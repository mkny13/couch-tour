*.iml
.gradle/
.kotlin/
build/
local.properties
*.jks
*.keystore
.idea/
.DS_Store
captures/
.externalNativeBuild/
.cxx/
store/

# macOS client (desktop client) — CouchTour.xcodeproj is generated by XcodeGen from
# macos/project.yml (see D92), not committed. .build/ is SwiftPM's build output; Generated/
# holds XcodeGen's generated Info.plist/entitlements.
macos/CouchTour.xcodeproj/
macos/**/.build/
macos/Generated/
macos/.DS_Store

# sync/ — the Cloudflare Worker backend. node_modules and wrangler's local D1/dev state are
# both machine-local and regenerated by `npm install` / `wrangler dev`.
sync/node_modules/
sync/.wrangler/
sync/.dev.vars
sync/.dev.vars.*
sync/.env
sync/.env.*

# Local agent scratch & WIP
.agents/
.wip/


# Python bytecode (scripts/uat-server.py)
__pycache__/
*.pyc

# Scratch build/test output and patches that kept getting committed from the repo root (#476)
/*.log
/stdout.txt
/stderr.txt
/*.patch

# smoke — failure screenshots contain the owner's signed-in library, favorites, and
# listening history. This repo is public. The committed evidence is the report.
smoke-reports/**/*.png
smoke-reports/*/mac-*.txt
smoke-reports/*/android-*.txt
